# Copy to /opt/cokuy/cokuy.env on the VPS (mode 0600, owner cokuy).
# Never commit real values.

# BotFather token for the single private bot.
TELEGRAM_BOT_TOKEN=

# Comma-separated numeric Telegram user IDs. At least one required.
# Get yours from @userinfobot. Strangers are silently dropped.
ALLOWED_USER_IDS=

# SQLite file path. Local disk only (WAL is unsafe on NFS/SMB).
SQLITE_PATH=/var/lib/cokuy/cokuy.db

# Provider-agnostic LLM endpoint. Swap providers by changing these three.
# Sumopod:  https://ai.sumopod.com/v1
# OpenRouter: https://openrouter.ai/api/v1
LLM_BASE_URL=https://ai.sumopod.com/v1
LLM_API_KEY=
LLM_MODEL=

# Optional JSON object of extra headers, e.g. OpenRouter attribution:
# {"HTTP-Referer":"https://example.com","X-Title":"Cokuy"}
LLM_EXTRA_HEADERS=

# Overall per-turn LLM deadline in seconds.
LLM_TIMEOUT_S=60

# USD per 1M tokens for server-side spend reporting. Defaults match the
# Sumopod promo rate for MiniMax-M2.7-highspeed; update when the model
# or promo changes so dashboard dollars stay honest.
LLM_PRICE_IN_PER_M=0.03
LLM_PRICE_OUT_PER_M=0.12

# Dashboard metrics endpoint. Loopback only, bearer token.
# Leave METRICS_TOKEN empty to disable the endpoint entirely.
METRICS_ADDR=127.0.0.1:8090
METRICS_TOKEN=
